#!/bin/sh
# Validate the staged compact-context snapshot when one of its sources changes.
# Semantic materiality cannot be inferred safely from file paths or diff size.

staged=$(
  git diff --cached --name-status |
    tr '\t' '\n' |
    grep -Ev '^[ACDMRTUXB][0-9]*$'
)

guarded=$(printf '%s\n' "$staged" | grep -E '^((AGENTS|CLAUDE)\.md|\.claude/settings\.json|\.agent/rules/.*|\.githooks/pre-commit|scripts/session-context\.(mjs|sh)|docs/(LOG\.md|agent/CURRENT\.md)|docs/engineering/STATUS\.md|docs/engineering/status/.*|docs/operations/WORKFLOW\.md|docs/INDEX\.md|tests/agent-context-contract\.test\.ts|package\.json)$')

[ -z "$guarded" ] && exit 0

repository_root=$(git rev-parse --show-toplevel) || exit 1
staged_generator=$(mktemp "${TMPDIR:-/tmp}/harvy-context.XXXXXX.mjs") || exit 1

cleanup() {
  rm -f -- "$staged_generator"
}
trap cleanup EXIT HUP INT TERM

if ! git show :scripts/session-context.mjs >"$staged_generator"; then
  echo "Commit ditahan: generator konteks tidak ada pada snapshot staged." >&2
  exit 1
fi

HARVY_CONTEXT_ROOT="$repository_root" node "$staged_generator" --check-staged || {
  cat >&2 <<'MESSAGE'

  Commit ditahan: kontrak konteks agent pada snapshot staged tidak valid.

  Stage seluruh sumber kontrak yang saling bergantung, jalankan
  `npm run context:check`, lalu commit ulang. Hook ini tidak menilai
  materialitas perubahan dan tidak mewajibkan catatan untuk commit kecil.

MESSAGE
  exit 1
}

exit 0
