{
  "name": "harvy",
  "version": "0.1.0",
  "private": true,
  "description": "Harvy, pendamping pelajar Indonesia untuk percakapan pribadi dan grup.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev-runner.ts",
    "start": "node dist/src/app.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "eval:conversation": "tsx scripts/evaluasi-percakapan.ts --all",
    "eval:group": "tsx scripts/evaluasi-grup.ts",
    "eval:group:full": "tsx scripts/evaluasi-grup.ts --all",
    "eval:group:direct": "tsx scripts/evaluasi-grup-direct.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "grammy": "^1.45.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
