{
  "name": "harvy",
  "version": "0.1.0",
  "private": true,
  "description": "Harvy, pendamping pelajar Indonesia untuk percakapan pribadi dan grup.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev-runner.ts",
    "start": "node dist/scripts/runtime-supervisor.js",
    "start:direct": "node dist/src/app.js",
    "start:sandbox": "node dist/src/sandbox-service.js",
    "start:local-git": "node dist/src/local-git-service.js",
    "start:github-broker": "node dist/src/github-broker-service.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "context:check": "node scripts/session-context.mjs --check",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "acceptance:sandbox": "tsx scripts/sandbox-live-acceptance.ts",
    "conformance:sandbox": "tsx scripts/sandbox-conformance-receipt.ts",
    "acceptance:github": "tsx scripts/github-live-acceptance.ts",
    "acceptance:provider": "tsx scripts/provider-live-smoke.ts",
    "acceptance:whatsapp": "tsx scripts/whatsapp-live-acceptance.ts",
    "acceptance:whatsapp-private": "tsx scripts/whatsapp-private-live-acceptance.ts",
    "backup:create": "tsx scripts/local-backup.ts create",
    "backup:verify": "tsx scripts/local-backup.ts verify",
    "backup:restore": "tsx scripts/local-backup.ts restore",
    "eval:conversation": "tsx scripts/evaluasi-percakapan.ts --all",
    "eval:routing": "tsx scripts/evaluasi-routing.ts",
    "eval:group": "tsx scripts/evaluasi-grup.ts",
    "eval:group:full": "tsx scripts/evaluasi-grup.ts --all",
    "eval:group:direct": "tsx scripts/evaluasi-grup-direct.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "grammy": "^1.45.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
