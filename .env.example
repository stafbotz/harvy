# Token bot Telegram utama tidak disimpan di .env. Atur dan verifikasi melalui
# `npm run console:setup`; Console menyimpannya terenkripsi di `secrets/`.
DATA_FILE=./data/tasks.json

# Memori terstruktur dan riwayat percakapan, terpisah per pengguna lewat ownerId.
# HISTORY_FILE berisi kata-kata pengguna apa adanya; perlakukan seperti data
# pribadi, bukan sekadar cache.
# MEMORY_FILE hanya dibaca sekali untuk mengimpor data lama. Memori yang aktif
# tersimpan sebagai berkas Markdown di dalam MEMORY_FOLDER, satu folder per
# pengguna, berikut catatan keselamatan yang tidak ditampilkan kepadanya.
MEMORY_FILE=./data/memories.json
MEMORY_FOLDER=./data/memori
HISTORY_FILE=./data/history.json
LONG_TERM_MEMORY_FILE=./data/long-term-memory.sqlite
# Isi tepat satu. Simpan file kunci di luar data/coding state yang dibackup.
HARVY_BACKUP_KEY_B64=
HARVY_BACKUP_KEY_FILE=

# Status kenalan dan persetujuan pemrosesan. Menghapus berkas ini membuat semua
# pengguna diminta menyetujui ketentuannya lagi dari awal.
PROFILE_FILE=./data/profiles.json
SESSION_FILE=./data/sessions.json
# Checkpoint agent yang sedang menunggu jawaban. Isinya dapat memuat permintaan,
# jawaban tool internal, dan progress run; perlakukan sebagai data pribadi.
AGENT_RUN_FILE=./data/agent-runs.json
TELEMETRY_FILE=./data/telemetry.json
TELEMETRY_RETENTION_DAYS=30

# --- Control plane, ledger biaya, dan Harvy Console lokal ---
# File ini tidak menyimpan isi chat. CONTROL_PLANE_FILE memuat installation key
# untuk HMAC subject/principal, jadi tetap merupakan secret operasional.
CONTROL_PLANE_FILE=./data/control-plane.json
USAGE_LEDGER_FILE=./data/usage-ledger.json
ENTITLEMENT_LEDGER_FILE=./data/entitlement-ledger.json
USAGE_LEDGER_RETENTION_DAYS=90
# Overlay beta mengalikan limit paket aktif; beta bukan paket atau consent.
BETA_QUOTA_MULTIPLIER=4

# --- Harvy Compute, funding, dan BYOK ---
# Economy state tidak memuat transcript. Ledger ini menyimpan reservasi,
# settlement, wallet, subscription, dan metadata credential secara auditable.
HARVY_ECONOMY_FILE=./data/economy.json
# Raw BYOK secret disimpan terenkripsi di file terpisah; tanpa master key BYOK
# sengaja nonaktif (Free/subscription tetap berjalan).
HARVY_BYOK_SECRET_FILE=./data/byok-secrets.json
HARVY_BYOK_MASTER_KEY_B64=
# Pembayaran langsung default-off. `local` hanya fake/test gateway development.
HARVY_PAYMENT_GATEWAY_MODE=disabled
HARVY_PAYG_COMPUTE_UNITS_PER_IDR=1000000
HARVY_USAGE_GETTING_LOW_BPS=5000
HARVY_USAGE_LOW_BPS=2000
HARVY_USAGE_NOTIFICATION_COOLDOWN_MS=86400000
HARVY_SUPPORT_MILESTONE=8

# Console tidak aktif secara bawaan dan versi ini hanya boleh loopback.
HARVY_CONSOLE_ENABLED=false
HARVY_CONSOLE_HOST=127.0.0.1
HARVY_CONSOLE_PORT=3210
# Development boleh kosong agar token acak ditampilkan satu kali di TTY.
# APP_ENV=production mewajibkan token acak minimal 32 karakter, tetapi server
# ini tetap bukan Console internet-ready; jangan expose melalui tunnel/proxy.
HARVY_CONSOLE_TOKEN=
DEFAULT_TIMEZONE=Asia/Jakarta
REMINDER_INTERVAL_MS=30000

# --- Log operasional (terpisah dari telemetry pengguna) ---
# Satu baris JSON per kejadian, tanpa Error.message, isi chat, prompt/balasan
# AI, identitas pengguna/grup, QR, token, atau kredensial. Detail hanya scalar
# teknis yang diizinkan; payload/object mentah dibuang. `debug`/`trace`
# membantu diagnosis sementara tetapi meningkatkan volume; produksi biasanya
# memakai `info`.
APP_ENV=development
RELEASE_SHA=0.1.0
LOG_LEVEL=info
LOG_FOLDER=./data/logs
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_BYTES=26214400
LOG_MAX_TOTAL_BYTES=262144000
LOG_QUEUE_MAX_RECORDS=10000
LOG_QUEUE_MAX_BYTES=8388608
LOG_CONSOLE=true
# pretty untuk terminal lokal; gunakan json agar stdout mudah dikirim ke
# collector produksi. LOG_RETENTION_DAYS hanya berlaku pada file lokal;
# retention collector wajib diatur sendiri. Logger berhenti menulis sementara
# saat stdout memberi backpressure agar buffer proses tidak tumbuh tanpa batas.
LOG_CONSOLE_FORMAT=pretty
# Aktifkan di deployment yang mewajibkan file log tersedia saat startup.
LOG_FILE_REQUIRED=false

# --- Supervisor proses lokal (`npm start`) ---
# Default berikut membuka crash-loop setelah delapan crash dalam lima menit.
# Shutdown normal memakai IPC agar lock dan transport sempat dibersihkan.
HARVY_RESTART_BASE_MS=500
HARVY_RESTART_MAX_MS=30000
HARVY_RESTART_STABLE_RESET_MS=300000
HARVY_RESTART_CRASH_WINDOW_MS=300000
HARVY_RESTART_MAX_CRASHES=8
HARVY_RESTART_SHUTDOWN_TIMEOUT_MS=65000

# --- WhatsApp melalui Baileys (beta lokal, opsional) ---
# Baileys adalah klien WhatsApp Web tidak resmi. Banyak nomor yang sah dapat
# dicantumkan, tetapi gunakan nomor uji nonkritis dan jangan merotasinya untuk
# menghindari pembatasan atau penegakan aturan WhatsApp.
# Daftar akun, status aktif, dan chat pribadi diatur melalui:
#   npm run console:setup
# Tiga field lama di bawah hanya dibaca untuk migrasi instalasi lama. Jangan
# tambahkan pada instalasi baru karena Console harus menjadi satu-satunya sumber.
# WHATSAPP_ENABLED=false
# WHATSAPP_PRIVATE_ENABLED=false
# WHATSAPP_ACCOUNTS=[{"id":"utama","phoneNumber":"6281234567890"}]

# qr (default) lebih andal untuk pairing awal. "code" tersedia sebagai opsi,
# tetapi alurnya sedang bermasalah pada sebagian versi/server Baileys.
WHATSAPP_PAIRING_MODE=qr

# Lokasi session dan state grup tetap dapat disesuaikan sebagai tuning path;
# default kode sama dengan nilai contoh berikut sehingga keduanya boleh dihapus.
WHATSAPP_AUTH_FOLDER=./data/whatsapp-auth
WHATSAPP_GROUP_FILE=./data/whatsapp-groups.json
# Capability GroupAgentRun tersedia di composition root, tetapi contoh tetap
# default-off. Aktifkan secara eksplisit hanya untuk deployment yang sudah
# menyiapkan WhatsApp, enrollment/binding, dan acceptance kanal; authority serta
# runtime fence tetap wajib dan tidak dapat dilewati oleh flag ini.
WHATSAPP_GROUP_AGENT_RUN_ENABLED=false
# State durable GroupAgentRun memuat permintaan dan input grup. Simpan di file
# terpisah dari WHATSAPP_GROUP_FILE agar kontrak/migrasi kedua repository tidak
# saling menimpa.
WHATSAPP_GROUP_AGENT_RUN_FILE=./data/whatsapp-group-agent-runs.json
# Intent cleanup tidak memuat isi chat, tetapi harus durable dan terpisah agar
# penghapusan scope dapat dilanjutkan setelah proses restart.
WHATSAPP_GROUP_AGENT_RUN_CLEANUP_FILE=./data/whatsapp-group-agent-run-cleanup.json
WHATSAPP_RECONNECT_BASE_MS=2000
WHATSAPP_RECONNECT_MAX_MS=60000

# Acceptance privat memakai akun tester WhatsApp terpisah yang sudah paired.
# Jangan isi dengan kontak pribadi biasa. Script menolak berjalan sampai dua
# konfirmasi eksplisit di bawah persis cocok dan selalu menghapus data akun uji
# melalui alur produk sebelum menyatakan lulus.
HARVY_WHATSAPP_PRIVATE_ACCEPTANCE_CONFIRM=
HARVY_WHATSAPP_PRIVATE_ACCEPTANCE_ACCOUNT=
HARVY_WHATSAPP_PRIVATE_ACCEPTANCE_TESTER_AUTH_FOLDER=
HARVY_WHATSAPP_PRIVATE_ACCEPTANCE_HARVY_JID=
HARVY_WHATSAPP_PRIVATE_ACCEPTANCE_RUN_LABEL=
HARVY_WHATSAPP_PRIVATE_ACCEPTANCE_TIMEOUT_MS=90000

# Acceptance Telegram privat memakai bot uji dan akun pengguna Telegram uji
# yang dipasangkan lewat tab Kanal uji pada `npm run console:setup`. api_id, api_hash,
# token bot, dan sesi pengguna disimpan terenkripsi di `secrets/`, bukan di
# file ini. Dua konfirmasi berikut wajib cocok sebelum pesan nyata dikirim.
HARVY_TELEGRAM_PRIVATE_ACCEPTANCE_CONFIRM=
HARVY_TELEGRAM_PRIVATE_ACCEPTANCE_ACCOUNT=
HARVY_TELEGRAM_PRIVATE_ACCEPTANCE_RUN_LABEL=
HARVY_TELEGRAM_PRIVATE_ACCEPTANCE_TIMEOUT_MS=90000

# Folder auth di atas berisi kredensial linked-device dan sudah diabaikan Git.
# Adapter berkas multi-file ini hanya untuk beta satu proses. Produksi perlu
# auth store database terenkripsi dengan kontrol akses dan rotasi operasional.
# QR live acceptance hanya tersedia sementara pada sesi Harvy Console
# localhost. Runtime WhatsApp umum masih membatasi fallback QR/kode terminal
# ke TTY ketika APP_ENV bukan production.

# --- Coding runtime production (control plane only, default fail-closed) ---
# Enabling this composition requires three separately deployed trust domains:
# isolated Linux sandbox, credentialless local-git, and optionally the
# credential-owning GitHub App broker. Harvy itself must not receive service
# credentials other than the dedicated RPC HMAC client secrets below.
HARVY_CODING_RUNTIME_ENABLED=false
HARVY_CODING_STATE_ROOT=./data/coding-runtime
# Base64url secret files, minimum 32 random bytes. Do not reuse these values.
HARVY_WORKSPACE_PRINCIPAL_SECRET_FILE=./secrets/workspace-principal.b64url
HARVY_CODING_CONFORMANCE_RECEIPT_FILE=./secrets/sandbox-conformance.json
# Exact SHA-256 of the receipt file. A missing, changed, or expired receipt
# keeps CodingRun admission closed even when the sandbox HTTP health is green.
HARVY_CODING_CONFORMANCE_RECEIPT_SHA256=
HARVY_CODING_AI_PRIVACY_DOMAIN=
# HTTP is permitted only for explicit loopback development. Production origins
# must be TLS service origins without path/query/fragment.
HARVY_CODING_ALLOW_INSECURE_LOOPBACK=false

HARVY_SANDBOX_ORIGIN=https://sandbox.internal.example:8443
HARVY_SANDBOX_HMAC_KEY_ID=harvy-control-v1
HARVY_SANDBOX_HMAC_SECRET_FILE=./secrets/sandbox-client-hmac.b64url

HARVY_LOCAL_GIT_ORIGIN=https://local-git.internal.example:8444
HARVY_LOCAL_GIT_HMAC_KEY_ID=harvy-control-v1
HARVY_LOCAL_GIT_HMAC_SECRET_FILE=./secrets/local-git-client-hmac.b64url

# GitHub is an independently gated optional capability. No PAT/App private key
# belongs in this process, chat, project snapshot, or sandbox.
HARVY_GITHUB_RUNTIME_ENABLED=false
HARVY_GITHUB_BROKER_ORIGIN=https://github-broker.internal.example:8445
HARVY_GITHUB_BROKER_HMAC_KEY_ID=harvy-control-v1
HARVY_GITHUB_BROKER_HMAC_SECRET_FILE=./secrets/github-broker-client-hmac.b64url

# --- Model AI ---
# testing    = satu model default lewat GMI Serving, tanpa provider fallback
# production = tiga slot accounting kompatibel lewat OpenRouter
AI_MODE=testing

# Batas token legacy 24 jam per pengguna. Pemeriksaan dan balasan keselamatan
# tidak pernah diblokir batas ini. Nilai 0 hanya menonaktifkan gate legacy;
# Harvy Compute forward-only tetap memberi Free allowance yang finite.
AI_ROLLING_24H_TOKEN_LIMIT=200000

# Harga tidak ditulis di kode karena berubah. Isi dari daftar harga penyedia
# untuk melihat estimasi biaya. Pasangan 0/0 berarti token-only dan tidak
# dibootstrap sebagai bukti model gratis; tarif nol sungguhan harus dibuat
# eksplisit sebagai versi harga melalui Harvy Console.
AI_PRICE_CHEAP_INPUT_PER_MILLION_USD=0
AI_PRICE_CHEAP_OUTPUT_PER_MILLION_USD=0
AI_PRICE_EFFICIENT_INPUT_PER_MILLION_USD=0
AI_PRICE_EFFICIENT_OUTPUT_PER_MILLION_USD=0
AI_PRICE_AMBITIOUS_INPUT_PER_MILLION_USD=0
AI_PRICE_AMBITIOUS_OUTPUT_PER_MILLION_USD=0

# Verifikasi ejaan persis ID model di daftar model penyedia sebelum dipakai.
# Nama dan harga model berubah cepat. Semua slot model nonkosong di bawah ini
# otomatis menjadi inventaris aman Harvy Console saat startup, termasuk model
# untuk mode yang sedang tidak aktif. Console hanya menerima pengaturan harga
# untuk pasangan provider+model tersebut; perubahan .env memerlukan restart.
# API Console tidak pernah membawa base URL, API key, atau credential lain.

# --- Mode testing: GMI Serving ---
# Endpoint OpenAI-compatible bawaan: https://api.gmi-serving.com/v1
# Simpan key hanya secara lokal dan jangan masukkan ke Git atau chat.
GMI_API_KEY=
AI_MODEL_TESTING=MiniMaxAI/MiniMax-M3
# Opsional: model uji per tingkatan. Tanpa ini routing tidak dapat diamati sama
# sekali dalam mode uji, karena satu model melayani semua tingkatan.
AI_MODEL_TESTING_CHEAP=
AI_MODEL_TESTING_EFFICIENT=
AI_MODEL_TESTING_AMBITIOUS=
# Opsional dan default-off: slot one-shot Phase M untuk eval. Wajib mempunyai
# profile exact di AI_MODEL_PROFILES serta privacy domain di bawah.
AI_MODEL_TESTING_TOUGHEST=

# --- Mode production: OpenRouter ---
OPENROUTER_API_KEY=
AI_MODEL_CHEAP=
AI_MODEL_EFFICIENT=
AI_MODEL_AMBITIOUS=
# Opsional: object JSON tertutup untuk mengikat cognitive role ke tier
# accounting dan exact model pada provider mode aktif. Role yang tidak ditulis
# memakai default tier kompatibel. Binding tidak membuktikan reasoning/tool
# capability; deklarasikan exact profile secara terpisah bila sudah diverifikasi.
# Contoh: {"orchestrator":{"tier":"ambitious","modelId":"vendor/model-id"}}
AI_MODEL_ROLE_BINDINGS=
# Opt-in specialist production. Saat true, lima role kritis wajib mempunyai
# exact modelId berbeda dan profile explicit; setup parsial menggagalkan startup.
# Strong worker juga wajib resolve ke profile explicit dengan structured output.
AI_SPECIALIST_DELEGATION_ENABLED=false
# Opsional dan default-off: slot toughest bukan tier percakapan ambient.
AI_MODEL_TOUGHEST=
# Label trust/privacy domain eksplisit (mis. provider upstream yang disetujui),
# tidak pernah ditebak dari substring ID model. Wajib bila slot toughest diisi.
AI_TOUGHEST_PRIVACY_DOMAIN=

# Opsional: array JSON profile capability exact provider+model. MiniMax-M3 pada
# endpoint resmi GMI mempunyai profile code-owned dari smoke live 25 Agustus
# 2026; custom gateway atau model lain tetap compatibility sampai profile exact
# diverifikasi. ID boleh berasal dari slot tier atau exact role binding.
AI_MODEL_PROFILES=

# Hanya diisi bila ingin menimpa alamat bawaan penyedia.
AI_BASE_URL=
