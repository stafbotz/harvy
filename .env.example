TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather
DATA_FILE=./data/tasks.json

# Memori terstruktur dan riwayat percakapan, terpisah per pengguna lewat ownerId.
# HISTORY_FILE berisi kata-kata pengguna apa adanya; perlakukan seperti data
# pribadi, bukan sekadar cache.
MEMORY_FILE=./data/memories.json
HISTORY_FILE=./data/history.json

# Status kenalan dan persetujuan pemrosesan. Menghapus berkas ini membuat semua
# pengguna diminta menyetujui ketentuannya lagi dari awal.
PROFILE_FILE=./data/profiles.json
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_UTC_OFFSET=+07:00
REMINDER_INTERVAL_MS=30000

# --- Model AI ---
# testing    = satu model gratis lewat Google AI Studio
# production = tiga model lewat OpenRouter, dipilih menurut kesulitan
AI_MODE=testing

# Verifikasi ejaan persis ID model di daftar model penyedia sebelum dipakai.
# Nama dan harga model berubah cepat.

# --- Mode testing: Google AI Studio ---
# Boleh lebih dari satu kunci, dipisah koma. Kunci dipakai bergantian agar
# kuota gratis tidak cepat habis saat pengembangan.
GOOGLE_AI_STUDIO_API_KEYS=
AI_MODEL_TESTING=

# --- Mode production: OpenRouter ---
OPENROUTER_API_KEY=
AI_MODEL_CHEAP=
AI_MODEL_EFFICIENT=
AI_MODEL_AMBITIOUS=

# Hanya diisi bila ingin menimpa alamat bawaan penyedia.
AI_BASE_URL=
