node_modules/
dist/
.env
data/*.json
# Durable memory SQLite state (including WAL/SHM sidecars) is private runtime
# data, never source. Tests use isolated temp directories.
data/*.sqlite*
# Lock satu proses untuk repository lokal; dapat tertinggal setelah crash.
*.runtime.lock
# Memori dan catatan keselamatan per pengguna. Ini data pribadi, bukan cache.
data/memori/
# Kredensial linked-device WhatsApp. Kebocoran folder ini setara mengambil alih
# sesi nomor Harvy; tidak boleh pernah masuk Git.
data/whatsapp-auth/
# State perjalanan exploratory live berisi percakapan akun uji dan hanya boleh
# tinggal lokal. Evidence di dalamnya content-free, tetapi tetap bukan source.
data/live-exploration/
# Coding snapshots/evidence and all local secret mounts are private runtime
# state. Service deployments should normally place these outside the checkout;
# these guards protect the documented development defaults.
data/coding-runtime/
data/sandbox-service/
data/local-git-service/
data/github-broker/
secrets/
# Log operasional append-only. Isinya sudah disaring, tetapi tetap merupakan
# artefak runtime dan tidak boleh masuk riwayat Git.
data/logs/
# Lindungi segmen juga bila LOG_FOLDER diarahkan ke folder lain di repository.
harvy-????????-????.ndjson
*.log
CLAUDE.local.md
.claude/settings.local.json
Harvy-MVP-v0.1.0.zip

# Sesi probe percakapan. `scripts/probe-chat.ts` menulis .probe-chat-session.json
# secara default dan isinya transkrip percakapan nyata, bukan cache.
.probe-chat-session.json
*.probe-chat-session.json
# --session= boleh menamai berkas lain; polanya dilebarkan supaya transkrip
# tidak masuk Git hanya karena namanya berbeda.
.probe-*.json
*.probe-session.json
